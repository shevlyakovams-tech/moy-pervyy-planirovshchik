{
  "name": "utrenniy-razvorot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Локальный утренний ежедневник в формате книжного разворота",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:database": "tsx scripts/test-database-lifecycle.ts",
    "test:performance": "tsx scripts/test-performance.ts",
    "prisma:generate": "prisma generate",
    "electron:install": "node node_modules/electron/install.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "seed:verify": "tsx scripts/verify-seed.ts",
    "licenses:check": "tsx scripts/check-licenses.ts",
    "acceptance:verify": "tsx scripts/verify-acceptance.ts",
    "pages:data": "node --experimental-strip-types scripts/build-pages-data.ts",
    "pages:serve": "node scripts/pages-server.mjs",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "build": "node scripts/build.mjs",
    "build:next": "next build",
    "build:electron": "esbuild ./src/electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "setup:internal": "tsx scripts/setup.ts",
    "start:internal": "electron dist-electron/main.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@prisma/client": "6.19.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "electron": "43.4.0",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "prisma": "6.19.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
